# Cabeçalhos HTTP de segurança (Netlify / Cloudflare Pages).
# Se for hospedar em outro lugar (Nginx, Apache), replique estes cabeçalhos lá.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://*.cdninstagram.com https://*.fbcdn.net https://i.ytimg.com https://www.instagram.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://www.instagram.com; frame-src https://www.youtube-nocookie.com https://www.instagram.com; connect-src 'self' https://graph.instagram.com https://www.instagram.com https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Cache longo para assets versionáveis.
/assets/*
  Cache-Control: public, max-age=31536000
